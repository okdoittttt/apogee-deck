# cp .env.example .env
# 주석 처리된 항목은 코드 기본값을 쓴다. 바꿀 때만 주석을 풀어서 설정한다.

# --- Compose ---
# 앱만 띄우려면 이 줄을 주석 처리하고 LANGFUSE 키를 비운다.
COMPOSE_FILE=docker-compose.yml:docker-compose.langfuse.yml

# --- LLM ---
# 처음 선택될 기본 모델의 provider. 모델은 화면의 드롭다운에서 고른다.
# anthropic | google | openai | ollama | fake (fake: 받은 메시지를 그대로 돌려주는 테스트용)
LLM_PROVIDER=anthropic
# 프롬프트에 넣는 "오늘 날짜"의 기준 시간대
APP_TIMEZONE=Asia/Seoul
# tool calling 을 지원하지 않는 모델이면 false
ENABLE_TOOLS=true
# vision 을 지원하지 않는 모델이면 false
ENABLE_VISION=true
# 컨텍스트 예산 계산 시 이미지 1장의 토큰 수
IMAGE_TOKEN_ESTIMATE=1500

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 드롭다운에 보여줄 모델 (쉼표로 구분)
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=64000

# --- OpenAI ---
# 키 발급: https://platform.openai.com/api-keys (선불 크레딧 차감)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# 드롭다운에 보여줄 모델 (쉼표로 구분). 비싼 모델이 실수로 쓰이지 않게 직접 정한다.
# OPENAI_MODELS=gpt-6-luna,gpt-5.6-luna,gpt-6.1-terra
# none | low | medium | high | xhigh | max. 추론을 지원하지 않는 모델만 쓰면 비운다.
# OPENAI_REASONING_EFFORT=low
# 추론 요약을 "생각 과정" 에 보여준다. 조직 인증이 안 된 계정에서 오류가 나면 false.
# OPENAI_REASONING_SUMMARY=true
# OPENAI_MAX_OUTPUT_TOKENS=8192
# OPENAI_TIMEOUT_SECONDS=120
# OPENAI_MAX_RETRIES=2

# --- Google (Gemini API) ---
# 키 발급: https://aistudio.google.com
# 무료 티어는 입력 내용이 Google 제품 개선에 쓰일 수 있으니 개인정보나 회사 자료는 넣지 않는다.
GOOGLE_API_KEY=
# gemma-4-26b-a4b-it(빠름) | gemma-4-31b-it(더 정확, 느림)
GOOGLE_MODEL=gemma-4-26b-a4b-it
# 드롭다운에 보여줄 모델 (쉼표로 구분)
# GOOGLE_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
# GOOGLE_MAX_OUTPUT_TOKENS=8192
# GOOGLE_INCLUDE_THOUGHTS=true
# GOOGLE_TIMEOUT_SECONDS=120
# 첫 요청 포함 시도 횟수. 크게 잡으면 한도 초과(429) 때 오래 멈춘다.
# GOOGLE_MAX_RETRIES=2

# --- Ollama ---
# 호스트에서 `ollama serve` 후 `ollama pull qwen3.5:9b`. 실행 중이면 설치된 모델이 드롭다운에 나온다.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# thinking 모델이면 true
OLLAMA_REASONING=true
# 입력+출력 토큰 수. 클수록 메모리를 많이 쓴다 (qwen3.5:9b 실측: 2만 토큰 입력 시 8.7GB)
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
# OLLAMA_TEMPERATURE=0.7
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_SECONDS=300

# --- 동시 요청 ---
# RUN_STALE_SECONDS=600
# 테스트용: fake 모델이 단어마다 기다리는 시간(초)
# FAKE_STREAM_DELAY_SECONDS=0.5

# --- Context ---
# 지난 턴의 도구 결과를 줄여서 모델에 보낸다
# COMPACT_TOOL_RESULTS=true
# 대화 이력 토큰 예산. 기본값 ollama: NUM_CTX - NUM_PREDICT - 256, google·openai: 32000, anthropic: 자르지 않음
# CONTEXT_MAX_TOKENS=3000

# --- Web search ---
# 키 발급: https://app.tavily.com (무료 월 1,000 크레딧). 비우면 웹 검색을 쓰지 않는다.
TAVILY_API_KEY=
# advanced(2 크레딧) | basic(1 크레딧)
# TAVILY_SEARCH_DEPTH=advanced
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT_SECONDS=20

# --- Web page reading (fetch_url, 키 불필요) ---
# ENABLE_FETCH_URL=true
# FETCH_MAX_CHARS=8000
# FETCH_TIMEOUT_SECONDS=15
# FETCH_MAX_BYTES=5000000

# --- Database ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent

# --- 로그인 (Google, 승인제) ---
# false 면 로그인 없이 로컬 사용자 한 명으로 동작한다 (개발용). 다른 사람이 접속하는 환경에서는 반드시 true.
AUTH_REQUIRED=true
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:8000/api/auth/google/callback (배포 시 도메인 주소도 추가)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 관리자 Google 이메일 (쉼표로 구분). 처음 로그인할 때 바로 승인되고 가입 신청 알림을 받는다.
ADMIN_EMAILS=
# 도메인 배포 시에만 지정 (비우면 *_PORT 로 자동 설정)
# FRONTEND_URL=https://chat.example.com
# BACKEND_PUBLIC_URL=https://chat.example.com
# SESSION_TTL_DAYS=30
# 가입 신청 알림 메일 (Gmail). 비밀번호는 계정 비밀번호가 아니라 앱 비밀번호(2단계 인증 필요):
#   https://myaccount.google.com/apppasswords
# 서버가 털려도 개인 메일함이 위험해지지 않게, 알림 발송 전용 Gmail 을 따로 만드는 것을 권장한다.
SMTP_USERNAME=
SMTP_PASSWORD=
# MAIL_FROM=
# 승인·거절 링크 유효 시간
# APPROVAL_LINK_TTL_HOURS=48

# --- 첨부 파일 저장소 (앱 전용 MinIO) ---
# 로컬 개발 외 환경에서는 반드시 바꾼다 (비밀번호 8자 이상)
MINIO_ROOT_USER=agent
MINIO_ROOT_PASSWORD=agent-minio-secret
# S3_BUCKET=attachments
# 첨부 원본 보관 기간(일)
# ATTACHMENT_RETENTION_DAYS=30

# --- 첨부 문서 ---
# DOCUMENT_MAX_BYTES=20971520
# DOCUMENT_MAX_PAGES=100
# 문서 하나의 파싱 시간 제한(초). OCR 이 많은 문서는 오래 걸린다.
# DOCUMENT_PARSE_TIMEOUT_SECONDS=180
# 동시에 파싱하는 문서 수 (OCR 은 CPU·메모리를 많이 쓴다)
# DOCUMENT_PARSE_WORKERS=1
# 올렸지만 보내지 않은 문서를 지우기까지의 시간
# DOCUMENT_UNSENT_TTL_HOURS=24
# 이보다 짧은 문서(추정 토큰)는 본문을 메시지에 바로 넣는다. 0 이면 항상 read_document 로 읽는다.
# DOCUMENT_INLINE_MAX_TOKENS=2000
# read_document 가 한 번에 보여줄 글자 수
# DOCUMENT_READ_MAX_CHARS=8000
# MAX_DOCUMENTS_PER_MESSAGE=5
# 프로젝트 하나에 넣을 수 있는 문서 분량 (추정 토큰 수 합계, 문서 수는 제한 없음)
# PROJECT_MAX_TOKENS=1000000
# 프로젝트 문서 합계가 이 이하면 본문을 모두 프롬프트에 넣는다 (Ollama 는 컨텍스트가 작아서 따로)
# PROJECT_INLINE_MAX_TOKENS=20000
# OLLAMA_PROJECT_INLINE_MAX_TOKENS=10000
# 프로젝트 문서의 그림을 설명할 OpenAI 모델 (OPENAI_API_KEY 필요, 없으면 그림 속 글자만 쓴다)
# VISION_MODEL=gpt-6-luna
# VISION_MAX_IMAGES_PER_DOCUMENT=50
# VISION_CONCURRENCY=3
# VISION_TIMEOUT_SECONDS=60
# 프로젝트 문서 검색(RAG) 임베딩: openai (OPENAI_API_KEY 필요, 없으면 검색 도구를 빼고 문서를 직접 읽음) | fake (테스트용)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# 차원을 바꾸면 DB 열(document_chunks.embedding)도 마이그레이션으로 바꿔야 한다
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_TIMEOUT_SECONDS=60
# 청크 크기 (추정 토큰 수): 작은 본문을 묶을 목표, 최대, 긴 본문을 나눌 때 겹치는 분량
# CHUNK_TARGET_TOKENS=500
# CHUNK_MAX_TOKENS=800
# CHUNK_OVERLAP_TOKENS=80
# search_project 가 돌려줄 청크 수
# PROJECT_SEARCH_TOP_K=8
# 하이브리드 검색: 벡터·키워드 검색이 각각 뽑을 후보 수, 결과 합치기(RRF) 상수 k
# PROJECT_SEARCH_CANDIDATES=30
# PROJECT_SEARCH_RRF_K=60

# --- Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
# MINIO_PORT=9100
# MINIO_CONSOLE_PORT=9101
LANGFUSE_PORT=3100
# 이 앱에는 인증이 없다. 0.0.0.0 으로 열면 같은 네트워크의 누구나 접속할 수 있다.
# BIND_HOST=127.0.0.1
# 도메인 배포 시에만 지정 (비우면 위 포트로 자동 설정)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000

# --- Langfuse ---
# 최초 기동 시 이 키로 프로젝트가 자동 생성된다. 비우면 트레이싱이 꺼진다.
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
# file(항상 로컬 파일) | langfuse(라벨 버전 사용, 실패 시 로컬 파일)
PROMPT_SOURCE=langfuse
PROMPT_LABEL=production
# 백엔드 시작 시 로컬 프롬프트를 Langfuse 로 동기화 (개발용)
PROMPT_SYNC_ON_STARTUP=true
# 웹 UI(http://localhost:3100) 관리자 계정
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=changeme123
# 로컬 개발 외 환경에서는 반드시 설정 (openssl rand -hex 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
