# 복사해서 사용: cp .env.example .env

# --- Compose 구성 ---
# Langfuse(트레이싱)까지 함께 띄운다. 앱만 띄우려면 이 줄을 주석 처리하고 LANGFUSE 키도 비울 것.
COMPOSE_FILE=docker-compose.yml:docker-compose.langfuse.yml

# --- LLM ---
# anthropic | ollama | fake (fake: LLM 없이 받은 메시지를 그대로 돌려주는 테스트용)
LLM_PROVIDER=anthropic
# system 프롬프트는 backend/app/agents/<에이전트>/prompts/*.md 에서 관리 (공용 조각: backend/app/prompts/shared/)
# 프롬프트에 들어가는 "오늘 날짜"의 기준 시간대
APP_TIMEZONE=Asia/Seoul
# 에이전트 도구 사용 여부 (tool calling 을 지원하지 않는 로컬 모델이면 false)
ENABLE_TOOLS=true
# 이미지 입력 허용 (vision 지원 모델만. ollama show <모델> 의 capabilities 에 vision 이 있어야 함)
ENABLE_VISION=true
# 컨텍스트 예산 계산 시 이미지 1장을 몇 토큰으로 볼지 (프론트엔드가 긴 변 1024px 로 줄여서 보냄)
IMAGE_TOKEN_ESTIMATE=1500

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (응답 품질 ↔ 비용/지연 트레이드오프)
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=64000

# Ollama — 호스트에서 `ollama serve` 후 `ollama pull qwen3.5:9b`
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# thinking 모델(qwen3.x 등)이면 true → 출력에서 <think> 분리. 일반 모델은 주석 처리.
OLLAMA_REASONING=true
# 모델이 한 번에 보는 토큰 수(입력+출력). 클수록 KV 캐시 메모리 증가 → `ollama ps` 로 확인하며 조정
OLLAMA_NUM_CTX=8192
# 출력 최대 토큰 (thinking 포함)
OLLAMA_NUM_PREDICT=4096
# 비우면 모델 권장값 사용
# OLLAMA_TEMPERATURE=0.7
OLLAMA_KEEP_ALIVE=10m
# Ollama 요청 타임아웃(초). Ollama 가 멈췄을 때 요청이 무한히 기다리지 않게 한다.
OLLAMA_TIMEOUT_SECONDS=300

# --- Context management ---
# 모델에 보낼 대화 이력 토큰 예산. 비우면 ollama: NUM_CTX - NUM_PREDICT - 256, anthropic: 자르지 않음
# CONTEXT_MAX_TOKENS=3000

# --- Database ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent

# --- Ports (호스트에 노출되는 포트. 충돌 시 변경) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
LANGFUSE_PORT=3100

# 아래 두 값은 비워두면 위 포트로 자동 설정됨. 도메인 배포 시에만 지정.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000

# --- Langfuse (트레이싱) ---
# Langfuse 최초 기동 시 이 키로 프로젝트가 자동 생성되고, 백엔드도 같은 키로 트레이스를 전송한다.
# 키를 비우면 백엔드 트레이싱이 꺼진다.
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
# 프롬프트 관리: file(항상 로컬 파일) | langfuse(라벨이 붙은 버전 사용, 실패 시 로컬 파일)
PROMPT_SOURCE=langfuse
# 실행 시 가져올 라벨 = 동기화 시 새 버전에 붙일 라벨
PROMPT_LABEL=production
# 백엔드 시작 시 git(로컬 파일) → Langfuse 자동 동기화 (개발 환경용)
PROMPT_SYNC_ON_STARTUP=true
# 웹 UI(http://localhost:3100) 관리자 계정
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=changeme123
# 로컬 개발 외 환경에서는 반드시 변경 (openssl rand -hex 32 등)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
